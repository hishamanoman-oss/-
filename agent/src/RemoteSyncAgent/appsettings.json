{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "AgentVersion": "10.0.1",
    "PollIntervalSeconds": 30,
    "HeartbeatIntervalSeconds": 20,
    "MaxBatchSize": 250,
    "InitialBackoffSeconds": 2,
    "MaxBackoffSeconds": 60,
    "DataDirectory": "",
    "ProtectionScope": "CurrentUser"
  }
}
